# ============================================================
# AI 通用平台分流规则 (AI General Platforms)
# 覆盖：OpenAI / ChatGPT / Sora / Google Gemini / Antigravity / AI Studio /
#       NotebookLM / Perplexity / xAI Grok / Cursor / Windsurf / Copilot /
#       Mistral / Poe / HuggingFace / Groq / OpenRouter 等
# 建议策略：非港节点（优先 新加坡 / 日本 / 美国 或 机场 GPT 专线）
# 维护：圈X语法，push后 GitHub Actions 自动生成 clash/rules/ai-general.yaml
# ============================================================

# ----- OpenAI / ChatGPT / Sora -----
host-suffix, openai.com, proxy
host-suffix, chatgpt.com, proxy
host-suffix, chat.com, proxy
host-suffix, sora.com, proxy
host-suffix, oaistatic.com, proxy
host-suffix, oaiusercontent.com, proxy
host-suffix, openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net, proxy
host, openaiapi-site.azureedge.net, proxy
host, openaicomproductionae4b.blob.core.windows.net, proxy
host, production-openaicom-storage.azureedge.net, proxy
host-keyword, openai, proxy

